<Window x:Class="NetUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NetUsageMonitor.Ui"
        Language="zh-CN" Title="网络流量监控" Height="680" Width="1080" MinHeight="480" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        Icon="Assets/app.ico">

    <Window.Resources>
        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="RightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ TOP BAR ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo + title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="26" Height="26" Margin="0,0,8,0" />
                <TextBlock Text="网络流量监控" FontSize="17" FontWeight="Bold" />
            </StackPanel>

            <!-- Search -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="搜索应用…" Foreground="{DynamicResource TextSecondary}"
                           Margin="10,0" IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- View controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0">
                <Button Command="{Binding TogglePauseCommand}" Content="{Binding PauseButtonText}"
                        Style="{StaticResource ToolButton}" Padding="9,6" Margin="0,0,8,0"
                        ToolTip="冻结列表以便选择应用，后台仍会继续记录流量" />
                <CheckBox Content="自动排序" IsChecked="{Binding AutoSort}" VerticalAlignment="Center"
                          ToolTip="实时更新列表排序。关闭后，应用的位置保持固定" />
            </StackPanel>

            <!-- Totals + actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↓" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalDownText}" Margin="4,0,8,0" FontFamily="Consolas" />
                        <TextBlock Text="↑" Foreground="{DynamicResource Accent}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalUpText}" Margin="4,0,0,0" FontFamily="Consolas" />
                    </StackPanel>
                </Border>

                <Button Command="{Binding ToggleRecordingCommand}" Style="{StaticResource ToolButton}"
                        Padding="9,6" Margin="0,0,8,0" ToolTip="暂停或继续记录流量">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentGreen}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding RecordingText}" />
                    </StackPanel>
                </Button>

                <Button Content="导出" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ToolButton}" Padding="9,6" Margin="0,0,8,0" ToolTip="将当前列表导出为 CSV 文件" />
                <Button Content="⚙ 设置" Click="OnSettingsClick" Style="{StaticResource ToolButton}" Padding="9,6" />
            </StackPanel>
        </Grid>

        <!-- ============ MAIN CONTENT ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Apps grid -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBg2}" CornerRadius="8" Padding="2">
                <DataGrid x:Name="AppsGrid"
                          ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}"
                          CanUserSortColumns="True"
                          CanUserResizeRows="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="永久保留记录" IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.DataContext.IsKept, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                                  Command="{Binding PlacementTarget.Tag.ToggleKeepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="忽略此应用（停止记录）" IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.DataContext.IsIgnored, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                                  Command="{Binding PlacementTarget.Tag.ToggleIgnoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="结束进程"
                                                  Command="{Binding PlacementTarget.Tag.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="仅跟踪此应用"
                                                  Command="{Binding PlacementTarget.Tag.OnlyTrackThisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="跟踪所有应用"
                                                  Command="{Binding PlacementTarget.Tag.TrackAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="删除此应用的记录"
                                                  Command="{Binding PlacementTarget.Tag.DeleteAppRecordsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="打开文件所在位置"
                                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="复制应用名称"
                                                  Command="{Binding PlacementTarget.Tag.CopyNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="应用" Width="*" MinWidth="120" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ExePath}">
                                        <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="↓ 下载速度" Binding="{Binding DownRate, Converter={StaticResource Rate}}"
                                            SortMemberPath="DownRate" Width="100"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="↑ 上传速度" Binding="{Binding UpRate, Converter={StaticResource Rate}}"
                                            SortMemberPath="UpRate" Width="100"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="时段下载" Binding="{Binding DownHour, Converter={StaticResource Bytes}}"
                                            SortMemberPath="DownHour" Width="88"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="时段上传" Binding="{Binding UpHour, Converter={StaticResource Bytes}}"
                                            SortMemberPath="UpHour" Width="88"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="时段合计" Binding="{Binding TotalHour, Converter={StaticResource Bytes}}"
                                            SortMemberPath="TotalHour" Width="88"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource RightHeader}" />

                        <DataGridTemplateColumn Header="状态" Width="120" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                 Style="{StaticResource StatusDot}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Detail panel -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBg2}" CornerRadius="8" Padding="0">
                <Grid>
                    <!-- Empty state -->
                    <TextBlock Text="选择一个应用即可查看流量详情、历史记录和管理选项。"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="16"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding SelectedRow, Converter={StaticResource NullVis}, ConverterParameter=invert}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16"
                                  Visibility="{Binding SelectedRow, Converter={StaticResource NullVis}}">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="{Binding SelectedRow.Icon}" Width="28" Height="28" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding SelectedRow.DisplayName}" FontSize="16" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedRow.ExePath}" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <!-- Status badges -->
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource BlockedBadgeBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                        Visibility="{Binding SelectedRow.IsBlocked, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="已禁止联网" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{DynamicResource LimitBadgeBg}" CornerRadius="4" Padding="6,2"
                                        Visibility="{Binding SelectedRow.CapTripped, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="已达限额" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>

                            <!-- Primary actions -->
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{Binding SelectedRow.BlockText}" Command="{Binding BlockCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                                <Button Content="结束进程" Command="{Binding KillProcessCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                                <Button Content="永久保留记录" Command="{Binding ToggleKeepCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                                <Button Content="忽略应用" Command="{Binding ToggleIgnoreCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                                <Button Content="仅跟踪此应用" Command="{Binding OnlyTrackThisCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                            </WrapPanel>

                            <!-- Live + averages -->
                            <TextBlock Text="实时流量与平均值" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="实时下载" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="实时上传" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentGreen}"
                                           Text="{Binding SelectedRow.DownRate, Converter={StaticResource Rate}}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent}"
                                           Text="{Binding SelectedRow.UpRate, Converter={StaticResource Rate}}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="时段平均下载" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="时段平均上传" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource StatValue}" Text="{Binding SelectedRow.AvgPerMinDownText}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding SelectedRow.AvgPerMinUpText}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="本次运行下载" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="本次运行上传" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource StatValue}" Text="{Binding SelectedRow.SessionDown, Converter={StaticResource Bytes}}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding SelectedRow.SessionUp, Converter={StaticResource Bytes}}" />
                            </Grid>

                            <!-- History -->
                            <TextBlock Text="保留时段流量" Style="{StaticResource SectionHeader}" />
                            <ui:UsageChart x:Name="Chart" Height="110" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGreen}" Margin="0,0,5,0" />
                                <TextBlock Text="下载" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,5,0" />
                                <TextBlock Text="上传" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="时段下载" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="时段上传" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource StatValue}" Text="{Binding SelectedRow.DownHour, Converter={StaticResource Bytes}}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding SelectedRow.UpHour, Converter={StaticResource Bytes}}" />
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="全部记录合计" Style="{StaticResource StatLabel}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="AllTimeText" Text="—" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Data limit -->
                            <TextBlock Text="流量限额（达限后禁止联网）" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding SelectedRow.CapText}" FontSize="13" FontWeight="SemiBold" />
                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding SelectedRow.CapPercent, Mode=OneWay}"
                                         Margin="0,5" Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelBg}"
                                         BorderThickness="0"
                                         Visibility="{Binding SelectedRow.HasCap, Converter={StaticResource BoolVis}}" />
                            <WrapPanel>
                                <Button Content="设置限额" Click="OnSetCap" Style="{StaticResource SmallButton}" />
                                <Button Content="重置限额计数" Command="{Binding ResetCapCommand}" CommandParameter="{Binding SelectedRow}"
                                        Style="{StaticResource SmallButton}" Visibility="{Binding SelectedRow.HasCap, Converter={StaticResource BoolVis}}" />
                                <Button Content="移除限额" Command="{Binding ClearCapCommand}" CommandParameter="{Binding SelectedRow}"
                                        Style="{StaticResource SmallButton}" Visibility="{Binding SelectedRow.HasCap, Converter={StaticResource BoolVis}}" />
                            </WrapPanel>

                            <!-- Connections -->
                            <TextBlock Text="连接记录" Style="{StaticResource SectionHeader}" />
                            <WrapPanel>
                                <Button Content="{Binding SelectedRow.RecordConnText}" Command="{Binding RecordConnectionsCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                                <Button Content="清除连接记录" Command="{Binding ClearConnectionsCommand}" CommandParameter="{Binding SelectedRow}"
                                        Style="{StaticResource SmallButton}"
                                        Visibility="{Binding SelectedRow.IsRecordingConnections, Converter={StaticResource BoolVis}}" />
                            </WrapPanel>
                            <TextBlock Text="启用后记录此应用连接的域名和 IP 地址。域名可能无法解析，且不会记录 HTTPS 完整网址。"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding SelectedRow.IsRecordingConnections, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                            <ItemsControl x:Name="ConnectionsList" MaxHeight="220"
                                          Visibility="{Binding SelectedRow.IsRecordingConnections, Converter={StaticResource BoolVis}}">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AlternateRowBg}" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Records -->
                            <TextBlock Text="记录管理" Style="{StaticResource SectionHeader}" />
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="打开文件所在位置" Command="{Binding OpenFileLocationCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                                <Button Content="删除此应用的记录" Command="{Binding DeleteAppRecordsCommand}"
                                        CommandParameter="{Binding SelectedRow}" Style="{StaticResource SmallButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg2}" CornerRadius="6" Padding="12,6" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AppCountText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding RetentionText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ModeText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding DbSizeText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Text="{Binding FolderText}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding FolderText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
