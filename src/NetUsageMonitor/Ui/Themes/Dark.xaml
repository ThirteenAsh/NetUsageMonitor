<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#0F141C" />
    <SolidColorBrush x:Key="PanelBg" Color="#1A2230" />
    <SolidColorBrush x:Key="PanelBg2" Color="#141B26" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3441" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F6FB" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA6B5" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
    <SolidColorBrush x:Key="RowHover" Color="#212C3B" />
    <SolidColorBrush x:Key="Selection" Color="#1E3A5F" />
    <SolidColorBrush x:Key="AlternateRowBg" Color="#15202E" />
    <SolidColorBrush x:Key="PrimaryButtonBg" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryButtonHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="BlockedBadgeBg" Color="#B32630" />
    <SolidColorBrush x:Key="LimitBadgeBg" Color="#9A4318" />
    <SolidColorBrush x:Key="StatusBlocked" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusCapped" Color="#F97316" />
    <SolidColorBrush x:Key="StatusKept" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusIgnored" Color="#6B7280" />
    <SolidColorBrush x:Key="StatusIdle" Color="#374151" />

    <SolidColorBrush x:Key="ChartDownloadFill" Color="#5510B981" />
    <Pen x:Key="ChartDownloadPen" Brush="{StaticResource AccentGreen}" Thickness="1.5" />
    <Pen x:Key="ChartUploadPen" Brush="{StaticResource Accent}" Thickness="1.5" />
    <Pen x:Key="ChartGridPen" Brush="#339AA6B5" Thickness="0.5" />
</ResourceDictionary>
